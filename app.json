{
  "expo": {
    "name": "Pantera",
    "slug": "pantera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Pantera turns what you say into text to log your meals.",
        "NSMicrophoneUsageDescription": "Pantera uses the microphone so you can say what you ate."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0720",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pantera.nutrition",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-test-variant",
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Pantera uses the camera to scan food barcodes and labels, and to photograph meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0720"
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pantera uses the microphone so you can say what you ate.",
          "speechRecognitionPermission": "Pantera turns what you say into text to log your meals.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#38C6F4"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Pantera",
              "label": "Pantera",
              "description": "Calories left, macros, water and quick actions",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sqlite"
    ],
    "scheme": "pantera",
    "backgroundColor": "#0B0720",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47712239-bfaa-447c-af6e-06eafc3319ca"
      }
    },
    "owner": "anthony_nounours",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47712239-bfaa-447c-af6e-06eafc3319ca"
    }
  }
}
